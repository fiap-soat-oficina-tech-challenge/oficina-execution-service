NODE_ENV=development
APPLICATION_PORT=3000
LOG_LEVEL=info

# Mesmo segredo do OS Service e da Lambda de autenticação: este serviço só valida
# o token, não emite.
JWT_SECRET=troque-pelo-mesmo-segredo-do-os-service

# Mensageria e banco. Localmente apontam para o LocalStack do docker-compose; no
# cluster vêm do ConfigMap (k8s/app/01-configmap.yaml).
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
EXECUTION_COMMANDS_QUEUE_URL=http://localhost:4566/000000000000/oficina-execution-commands
SAGA_REPLIES_QUEUE_URL=http://localhost:4566/000000000000/oficina-os-saga-replies
DYNAMODB_TABLE_TAREFAS=oficina-execution-tarefas

# Observabilidade (desligada no ambiente local)
NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=oficina-execution
